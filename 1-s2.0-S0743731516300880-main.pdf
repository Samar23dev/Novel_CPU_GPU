<rdf:Description rdf:about=""> 
<dc:format>application/pdf</dc:format> 
<dc:title>A novel cooperative accelerated parallel two-list algorithm for solving the subset-sum problem on a hybrid CPU&#x2013;GPU cluster</dc:title> 
<dc:creator> 
  <rdf:Seq>
    <rdf:li>Lanjun Wan</rdf:li>

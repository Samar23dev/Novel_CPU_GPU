    <rdf:li>Heterogeneous cooperative computing</rdf:li>
    <rdf:li>Hybrid CPU&#x2013;GPU cluster</rdf:li>
    <rdf:li>Hybrid programming model</rdf:li>
    <rdf:li>Subset-sum problem</rdf:li>
    <rdf:li>Two-list algorithm</rdf:li>
    <rdf:li>Workload distribution</rdf:li>
  </rdf:Bag>
</dc:subject>
